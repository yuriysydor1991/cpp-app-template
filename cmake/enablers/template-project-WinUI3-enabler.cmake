cmake_minimum_required(VERSION 3.13)

# Enabler module for the Microsoft WinUI 3 + C++/WinRT GUI stack.
#
# WinUI 3 is a Windows-only UI framework shipped through the Windows App SDK and
# the C++/WinRT projection (both distributed as NuGet packages) and built with
# the MSVC toolchain. This module makes them available on Windows and exposes the
# winui3::sdk interface target the native UI links against.
#
# On a non-Windows host this module is a deliberate no-op: the portable WinUI3
# orchestration (winui3::WinUI3Controller + the WindowConfig helper) and the
# cross-platform run_winui_application() stub are still built, so the project
# configures, builds and runs its unit/component tests everywhere (handy for the
# CI of the platform-independent logic). The real WinUI 3 window only builds on
# Windows. See src/winui3 and the WinUI 3 documentation section.

option(
  ENABLE_WINUI3
  "Enables the WinUI 3 + C++/WinRT GUI (Windows only; the portable parts + a stub build elsewhere)"
  ON
)

if(NOT ENABLE_WINUI3)
  return()
endif()

if(NOT WIN32)
  message(STATUS "WinUI 3 is a Windows-only framework")
  message(STATUS "Skipping the native Windows App SDK setup; the portable WinUI3 orchestration and the non-Windows run_winui_application() stub will be built instead")
  return()
endif()

if(NOT MSVC)
  message(WARNING "WinUI 3 + C++/WinRT is only supported with the MSVC toolchain")
endif()

# The Windows App SDK ships its native libraries per target architecture.
string(TOLOWER "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}" WINUI3_ARCH)

if(NOT WINUI3_ARCH MATCHES "^(x64|x86|arm64)$")
  message(FATAL_ERROR
    "The Windows App SDK supports the x64, x86 and arm64 targets only, not "
    "'${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}'")
endif()

set(
  TEMPLATE_APP_WINAPPSDK_VERSION "1.6.250228001"
  CACHE STRING "The Microsoft.WindowsAppSDK NuGet package version to restore"
)
set(
  TEMPLATE_APP_CPPWINRT_VERSION "2.0.240111.5"
  CACHE STRING "The Microsoft.Windows.CppWinRT NuGet package version to restore"
)
set(
  TEMPLATE_APP_WEBVIEW2_VERSION "1.0.2651.64"
  CACHE STRING "The Microsoft.Web.WebView2 NuGet package version (a Windows App SDK dependency) to restore"
)

# Restore the Windows App SDK + C++/WinRT NuGet packages next to the build tree.
find_program(NUGET_EXEC nuget)

set(WINUI3_PACKAGES_DIR "${CMAKE_BINARY_DIR}/winui3-packages")
set(WINUI3_PACKAGES_CONFIG "${CMAKE_BINARY_DIR}/winui3-packages.config")

configure_file(
  "${CMAKE_SOURCE_DIR}/misc/winui3/packages.config.in"
  "${WINUI3_PACKAGES_CONFIG}"
  @ONLY
)

if(NUGET_EXEC)
  execute_process(
    COMMAND "${NUGET_EXEC}" restore "${WINUI3_PACKAGES_CONFIG}"
            -PackagesDirectory "${WINUI3_PACKAGES_DIR}"
    RESULT_VARIABLE WINUI3_NUGET_RESULT
  )
  if(NOT WINUI3_NUGET_RESULT EQUAL 0)
    message(WARNING "NuGet restore of the Windows App SDK / C++/WinRT packages failed (code ${WINUI3_NUGET_RESULT})")
  endif()
else()
  message(WARNING
    "nuget(.exe) was not found - cannot restore the Windows App SDK / C++/WinRT "
    "packages into ${WINUI3_PACKAGES_DIR}. Install the NuGet CLI from "
    "https://www.nuget.org/downloads")
endif()

set(WINAPPSDK_ROOT "${WINUI3_PACKAGES_DIR}/Microsoft.WindowsAppSDK.${TEMPLATE_APP_WINAPPSDK_VERSION}")

# The C++/WinRT projection headers (winrt/*.h) are generated by the restored
# cppwinrt.exe from the Windows SDK, Windows App SDK and WebView2 metadata.
set(
  WINUI3_CPPWINRT_GEN "${CMAKE_BINARY_DIR}/winui3-cppwinrt"
  CACHE PATH "Output directory of the generated C++/WinRT projection headers"
)

set(WINUI3_CPPWINRT_EXEC "${WINUI3_PACKAGES_DIR}/Microsoft.Windows.CppWinRT.${TEMPLATE_APP_CPPWINRT_VERSION}/bin/cppwinrt.exe")

# lib/uap10.0.17763 only repeats older copies of the lib/uap10.0.18362 metadata.
file(
  GLOB WINUI3_WINMDS
  "${WINAPPSDK_ROOT}/lib/uap10.0/*.winmd"
  "${WINAPPSDK_ROOT}/lib/uap10.0.18362/*.winmd"
  "${WINUI3_PACKAGES_DIR}/Microsoft.Web.WebView2.${TEMPLATE_APP_WEBVIEW2_VERSION}/lib/*.winmd"
)

if(NOT EXISTS "${WINUI3_CPPWINRT_EXEC}" OR NOT WINUI3_WINMDS)
  message(FATAL_ERROR
    "The C++/WinRT and Windows App SDK NuGet packages are missing from "
    "${WINUI3_PACKAGES_DIR}: restore them with the NuGet CLI or configure with "
    "-DENABLE_WINUI3=OFF")
endif()

# The Windows SDK the Visual Studio generator targets, else the current one.
if(CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION)
  set(WINUI3_CPPWINRT_COMMAND "${WINUI3_CPPWINRT_EXEC}" -input "${CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION}")
else()
  set(WINUI3_CPPWINRT_COMMAND "${WINUI3_CPPWINRT_EXEC}" -input sdk)
endif()

foreach(winmd IN LISTS WINUI3_WINMDS)
  list(APPEND WINUI3_CPPWINRT_COMMAND -input "${winmd}")
endforeach()

list(APPEND WINUI3_CPPWINRT_COMMAND -output "${WINUI3_CPPWINRT_GEN}")

# Generate again only when the command (versions, metadata) changes.
set(WINUI3_CPPWINRT_STAMP "${WINUI3_CPPWINRT_GEN}/cppwinrt-command.txt")
set(WINUI3_CPPWINRT_DONE "")

if(EXISTS "${WINUI3_CPPWINRT_STAMP}")
  file(READ "${WINUI3_CPPWINRT_STAMP}" WINUI3_CPPWINRT_DONE)
endif()

if(NOT WINUI3_CPPWINRT_DONE STREQUAL "${WINUI3_CPPWINRT_COMMAND}")
  message(STATUS "Generating the C++/WinRT projection headers into ${WINUI3_CPPWINRT_GEN}")

  execute_process(
    COMMAND ${WINUI3_CPPWINRT_COMMAND}
    RESULT_VARIABLE WINUI3_CPPWINRT_RESULT
  )

  if(NOT WINUI3_CPPWINRT_RESULT EQUAL 0)
    message(FATAL_ERROR "cppwinrt.exe failed to generate the C++/WinRT projection (code ${WINUI3_CPPWINRT_RESULT})")
  endif()

  file(WRITE "${WINUI3_CPPWINRT_STAMP}" "${WINUI3_CPPWINRT_COMMAND}")
endif()

add_library(winui3-sdk INTERFACE)
add_library(winui3::sdk ALIAS winui3-sdk)

# The C++/WinRT coroutines need C++20 (C++17 needs the /await extension), and
# the projection headers produce big object files.
target_compile_features(winui3-sdk INTERFACE cxx_std_20)
target_compile_options(winui3-sdk INTERFACE /bigobj)

target_include_directories(
  winui3-sdk INTERFACE
  "${WINUI3_CPPWINRT_GEN}"
  "${WINAPPSDK_ROOT}/include"
)

# WindowsApp.lib provides the base WinRT activation; the Windows App SDK runtime
# bootstrapper lib lets an unpackaged executable load the WinUI 3 runtime.
target_link_libraries(
  winui3-sdk INTERFACE
  WindowsApp.lib
  "${WINAPPSDK_ROOT}/lib/win10-${WINUI3_ARCH}/Microsoft.WindowsAppRuntime.Bootstrap.lib"
)

message(STATUS "WinUI 3 SDK target 'winui3::sdk' configured (Windows App SDK ${TEMPLATE_APP_WINAPPSDK_VERSION}, C++/WinRT ${TEMPLATE_APP_CPPWINRT_VERSION}, ${WINUI3_ARCH})")
