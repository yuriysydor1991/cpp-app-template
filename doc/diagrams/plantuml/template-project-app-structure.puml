@startuml

package Applications-hierarchy {
  abstract class IApplication {
    +{abstract} int run(std::shared_ptr<ApplicationContext> ctx)

    +{static}inline constexpr const int INVALID = 1;
  }

  class Application {
    +{abstract} int run(std::shared_ptr<ApplicationContext> ctx)
  }

  class ApplicationHelpPrinter {
    +{abstract} int run(std::shared_ptr<ApplicationContext> ctx)
  }

  class ApplicationVersionPrinter {
    +{abstract} int run(std::shared_ptr<ApplicationContext> ctx)
  }
}

class ApplicationContext {
  -int& margc
  -char**& margv
  -bool mprint_help_and_exit{false}
  -bool mprint_version_and_exit{false}
  -std::vector<std::string> merrors
  -std::atomic_bool mstop{false}
  -std::atomic_bool mpause{false}
  -std::atomic_bool mreload{false}
  -std::atomic_bool mfirst_user_request{false}
  -std::atomic_bool msecond_user_request{false}
  +int& get_argc() const
  +char**& get_argv() const
  +bool get_print_help_and_exit() const
  +void set_print_help_and_exit(const bool newValue)
  +bool get_print_version_and_exit() const
  +void set_print_version_and_exit(const bool newValue)
  +const std::vector<std::string>& get_errors() const
  +void push_error(const std::string& errorDescription)
  +bool get_stop() const
  +void set_stop(const bool newValue)
  +bool get_pause() const
  +void set_pause(const bool newValue)
  +bool get_reload() const
  +void set_reload(const bool newValue)
  +bool get_first_user_request() const
  +void set_first_user_request(const bool newValue)
  +bool get_second_user_request() const
  +void set_second_user_request(const bool newValue)
}

package Facade {
  class ApplicationFactory {
    +{abstract} std::shared_ptr<ApplicationContext> create_default_context(int& gargc, char**& gargv)
    +{abstract} std::shared_ptr<CommandLineParser> create_default_arg_parser()
    +{abstract} std::shared_ptr<ISignalsHandler> create_default_signals_handler()
    +{abstract} std::shared_ptr<IApplication> create_default_application()
    +{abstract} std::shared_ptr<IApplication> create_help_printer()
    +{abstract} std::shared_ptr<IApplication> create_version_printer()
    +{abstract} std::shared_ptr<ApplicationContext> create_context(int& gargc, char**& gargv)
    +{abstract} bool init_logging(std::shared_ptr<ApplicationContext> ctx)
    +{abstract} std::shared_ptr<IApplication> create_application(std::shared_ptr<ApplicationContext> ctx)
    +{abstract} int run(int& gargc, char**& gargv)
    +{static} int execute(int& gargc, char**& gargv)
  }
}

package CMD-flags-parser {
  class CommandLineParser {
    +{abstract} bool parse_args(std::shared_ptr<ApplicationContext> ctx)
    +{static} std::string get_custom_logfile(const int& gargc, char** const& gargv)
    #{abstract} bool parse_arg(std::shared_ptr<ApplicationContext> ctx, const std::string& param, const bool hasNext, const std::string& nextParam, int& paramIndex)
    #{abstract} bool check_4_data(std::shared_ptr<ApplicationContext> ctx,const std::string& param, const bool hasNext, const std::string& nextParam)
    #{abstract} const std::set<std::string>& get_params_requiring_data()
    #{abstract} bool requires_data(const std::string& param)
  }

  class CMDParamNames {
    +{static} inline const std::string HELPW{"--help"};
    +{static} inline const std::string HELP{"-h"};
    +{static} inline const std::string VERSIONW{"--version"};
    +{static} inline const std::string VERSION{"-v"};
    +{static} inline const std::string LOGPATHW{"--log-file"};
    +{static} inline const std::string LOGPATH{"-l"};
  }
}

package Signals-handlers {
  abstract class ISignalsHandler {
    +{abstract} bool install(std::shared_ptr<ApplicationContext> ctx)
    +{abstract} void uninstall()
  }

  class SignalsHandler {
    +{abstract} bool install(std::shared_ptr<ApplicationContext> ctx)
    +{abstract} void uninstall()
    #{abstract} std::vector<std::shared_ptr<ISignalsHandler>> create_handlers()
    -std::vector<std::shared_ptr<ISignalsHandler>> mhandlers
  }

  abstract class ASignalsHandler {
    +{abstract} bool install(std::shared_ptr<ApplicationContext> ctx)
    +{abstract} void uninstall()
    #{abstract} const std::set<int>& get_handled_signals()
    #{abstract} SignalDisposition get_signal_disposition()
    #{abstract} void store_context(ApplicationContext* ctx)
    -std::map<int, SignalDisposition> mprevious_dispositions
  }

  package posix {
    abstract class PosixSignalsHandler {
    }

    class StopSignalsHandler {
      #const std::set<int>& get_handled_signals()
      #SignalDisposition get_signal_disposition()
      #void store_context(ApplicationContext* ctx)
      #{static} void stop_context(int signalNumber)
      -{static} inline std::atomic<ApplicationContext*> mhandled_context{nullptr}
    }
    note bottom of StopSignalsHandler : SIGINT, SIGTERM, SIGQUIT

    class PauseSignalsHandler {
      #const std::set<int>& get_handled_signals()
      #SignalDisposition get_signal_disposition()
      #void store_context(ApplicationContext* ctx)
      #{static} void pause_context(int signalNumber)
      -{static} inline std::atomic<ApplicationContext*> mhandled_context{nullptr}
    }
    note bottom of PauseSignalsHandler : SIGTSTP

    class ContinueSignalsHandler {
      #const std::set<int>& get_handled_signals()
      #SignalDisposition get_signal_disposition()
      #void store_context(ApplicationContext* ctx)
      #{static} void continue_context(int signalNumber)
      -{static} inline std::atomic<ApplicationContext*> mhandled_context{nullptr}
    }
    note bottom of ContinueSignalsHandler : SIGCONT

    class ReloadSignalsHandler {
      #const std::set<int>& get_handled_signals()
      #SignalDisposition get_signal_disposition()
      #void store_context(ApplicationContext* ctx)
      #{static} void reload_context(int signalNumber)
      -{static} inline std::atomic<ApplicationContext*> mhandled_context{nullptr}
    }
    note bottom of ReloadSignalsHandler : SIGHUP

    class UserSignalsHandler {
      #const std::set<int>& get_handled_signals()
      #SignalDisposition get_signal_disposition()
      #void store_context(ApplicationContext* ctx)
      #{static} void request_context(int signalNumber)
      -{static} inline std::atomic<ApplicationContext*> mhandled_context{nullptr}
    }
    note bottom of UserSignalsHandler : SIGUSR1, SIGUSR2

    class IgnoredSignalsHandler {
      #const std::set<int>& get_handled_signals()
      #SignalDisposition get_signal_disposition()
      #void store_context(ApplicationContext* ctx)
    }
    note bottom of IgnoredSignalsHandler : SIGPIPE (SIG_IGN)
  }
}

IApplication <|.. Application
IApplication <|.. ApplicationHelpPrinter
IApplication <|.. ApplicationVersionPrinter

ApplicationContext --> IApplication
ApplicationContext --> Application
ApplicationContext --> ApplicationHelpPrinter
ApplicationContext --> ApplicationVersionPrinter
ApplicationContext --> ApplicationFactory
ApplicationContext --> ISignalsHandler
ApplicationContext --> SignalsHandler

ApplicationFactory <.. IApplication
ApplicationFactory <.. Application
ApplicationFactory <.. ApplicationHelpPrinter
ApplicationFactory <.. ApplicationVersionPrinter
ApplicationFactory <.. ApplicationContext
ApplicationFactory <.. CommandLineParser
ApplicationFactory <.. ISignalsHandler
ApplicationFactory <.. SignalsHandler

ISignalsHandler <|.. SignalsHandler
ISignalsHandler <|.. ASignalsHandler
ASignalsHandler <|-- PosixSignalsHandler
PosixSignalsHandler <|-- StopSignalsHandler
PosixSignalsHandler <|-- PauseSignalsHandler
PosixSignalsHandler <|-- ContinueSignalsHandler
PosixSignalsHandler <|-- ReloadSignalsHandler
PosixSignalsHandler <|-- UserSignalsHandler
PosixSignalsHandler <|-- IgnoredSignalsHandler
SignalsHandler o-- ISignalsHandler : mhandlers

CommandLineParser <.. CMDParamNames

@enduml
