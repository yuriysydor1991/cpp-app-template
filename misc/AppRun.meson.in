#!/bin/sh
#
# AppRun entry point for the @PROJECT_BINARY_NAME@ AppImage bundle.
# Generated by the Meson `template-project-AppImage-enabler` module.
#
# The bundle layout follows whatever meson `--prefix` was used at setup
# time (default `/usr/local`). To get the standard AppImage `AppDir/usr/bin`
# layout configure the build dir with the `--prefix=/usr` before running the
# `AppImage` target.
#
HERE="$(dirname "$(readlink -f "${0}")")"

BIN="$(find "${HERE}" -name "@PROJECT_BINARY_NAME@" -type f -executable 2>/dev/null | head -1)"
if [ -z "${BIN}" ]; then
  BIN="${HERE}/usr/@PROJECT_BINARY_INSTALLATION_DIR@/@PROJECT_BINARY_NAME@"
fi

BIN_DIR="$(dirname "${BIN}")"
PREFIX_DIR="$(dirname "${BIN_DIR}")"

export PATH="${BIN_DIR}:${PATH}"
export LD_LIBRARY_PATH="${PREFIX_DIR}/@PROJECT_LIBRARY_INSTALLATION_DIR@:${PREFIX_DIR}/lib:${PREFIX_DIR}/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export XDG_DATA_DIRS="${PREFIX_DIR}/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

exec "${BIN}" "$@"
