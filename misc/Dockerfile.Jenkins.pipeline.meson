FROM jenkins/jenkins:lts

USER root

RUN apt update
RUN apt install -y libstdc++6 build-essential git g++ pkg-config
RUN apt install -y meson ninja-build
RUN apt install -y clang-format
RUN apt install -y cppcheck
RUN apt install -y rpm
RUN apt install -y doxygen graphviz
RUN apt install -y clang-tidy
RUN apt install -y libgtest-dev
RUN apt install -y libgmock-dev

USER jenkins

CMD ["jenkins.sh"]
