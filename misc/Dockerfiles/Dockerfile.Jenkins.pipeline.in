# syntax=docker/dockerfile:1
FROM jenkins/jenkins:lts

USER root

ARG DEBIAN_FRONTEND=noninteractive
ARG srcD=/usr/src

# The whole branch set installs in a single apt transaction, so the dependency
# resolution runs once instead of once per package group, and the BuildKit
# caches keep the archives and the package lists for the next image build.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
  rm -f /etc/apt/apt.conf.d/docker-clean && \
  echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache && \
  apt-get update && \
  apt-get upgrade -y && \
  apt-get install -y \
    autoconf automake build-essential ccache clang-format clang-tidy cmake \
    cppcheck doxygen file git graphviz libgmock-dev libgtest-dev meson \
    ninja-build pkg-config valgrind \
    flatpak flatpak-builder fuse3 libfuse2t64 rpm \
    firebird-dev libboost-all-dev libcurl4-openssl-dev liblog4cpp5-dev \
    liblzma-dev libmysqlcppconn-dev libpqxx-dev libssl-dev libsystemd-dev \
    libxml2-dev nlohmann-json3-dev zlib1g-dev \
    freeglut3-dev libepoxy-dev libgl-dev libglew-dev libglm-dev libopengl-dev \
    libvulkan-dev mesa-common-dev mesa-vulkan-drivers \
    libadwaita-1-dev libglib2.0-dev-bin libgtkmm-3.0-dev libgtkmm-4.0-dev \
    libwebkitgtk-6.0-dev \
    libqt6opengl6-dev qt6-base-dev qt6-base-dev-tools qt6-charts-dev \
    qt6-declarative-dev qt6-location-dev qt6-positioning-dev qt6-tools-dev \
    qt6-tools-dev-tools qt6-webengine-dev qt6-webengine-dev-tools \
    qt6-webview-dev \
    qml6-module-qtqml-workerscript qml6-module-qtquick \
    qml6-module-qtquick-controls qml6-module-qtquick-dialogs \
    qml6-module-qtquick-layouts qml6-module-qtquick-shapes \
    qml6-module-qtquick-templates qml6-module-qtquick-window \
    libsdl2-dev libsdl2-image-dev libsdl2-net-dev libsdl2-ttf-dev \
    libsdl3-dev libsdl3-image-dev libsdl3-ttf-dev libsfml-dev \
    ffmpeg libgstreamer1.0-dev libgstreamerd-3-dev libgstreamermm-1.0-dev \
    libnotify-dev \
    giza-dev gnuplot libcfitsio-dev libopencv-dev libplplot-dev wcslib-dev \
    btop curl fdupes htop nano nmap traceroute wget whois

# The appimage target of every branch demands the appimagetool in the PATH. The
# extracted tool starts without FUSE and the pinned runtime spares the package
# build the per run runtime download the tool does otherwise.
RUN arch="$(uname -m)" && \
  case "$arch" in armv7l) arch=armhf ;; esac && \
  curl -fsSL -o /tmp/appimagetool \
    https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-$arch.AppImage && \
  chmod +x /tmp/appimagetool && \
  (cd /tmp && ./appimagetool --appimage-extract > /dev/null) && \
  mv /tmp/squashfs-root /opt/appimagetool && \
  curl -fsSL -o /opt/appimagetool/runtime \
    https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-$arch && \
  printf '#!/bin/sh\nexec /opt/appimagetool/AppRun --runtime-file /opt/appimagetool/runtime "$@"\n' \
    > /usr/local/bin/appimagetool && \
  chmod +x /usr/local/bin/appimagetool && \
  rm -f /tmp/appimagetool

# Every library the distribution ships no package of is cloned, built and
# erased inside a single layer, so the sources never reach the image.

# wxWidgets
RUN git clone --branch v3.3.2 --depth 1 --single-branch --recurse-submodules \
    --shallow-submodules https://github.com/wxWidgets/wxWidgets.git $srcD/wxWidgets && \
  cmake -S $srcD/wxWidgets -B $srcD/wxWidgets-build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr && \
  cmake --build $srcD/wxWidgets-build -j$(nproc) && \
  cmake --install $srcD/wxWidgets-build --strip && \
  rm -fr $srcD/wxWidgets $srcD/wxWidgets-build

# Witty
RUN git clone --branch 4.11.4 --depth 1 --single-branch \
    https://github.com/emweb/wt.git $srcD/wt && \
  cmake -S $srcD/wt -B $srcD/wt-build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr -DENABLE_LIBWTDBO=OFF -DENABLE_OPENGL=OFF \
    -DENABLE_FIREBIRD=OFF -DENABLE_POSTGRES=OFF -DENABLE_SQLITE=OFF \
    -DENABLE_MYSQL=OFF -DENABLE_MSSQLSERVER=OFF -DINSTALL_DOCUMENTATION=OFF \
    -DBUILD_EXAMPLES=OFF -DENABLE_QT4=OFF -DENABLE_QT5=OFF -DENABLE_QT6=OFF \
    -DENABLE_LIBWTTEST=OFF -DENABLE_PANGO=OFF -DENABLE_HARU=OFF \
    -DCONNECTOR_FCGI=OFF -DBUILD_TESTS=OFF -DCONNECTOR_ISAPI=OFF && \
  cmake --build $srcD/wt-build -j$(nproc) && \
  cmake --install $srcD/wt-build --strip && \
  rm -fr $srcD/wt $srcD/wt-build

# SQLiteCpp, at the revision the appSQLiteCpp3 branch fetches
RUN git clone --branch 3.3.3 --depth 1 --single-branch \
    https://github.com/SRombauts/SQLiteCpp.git $srcD/SQLiteCpp && \
  cmake -S $srcD/SQLiteCpp -B $srcD/SQLiteCpp-build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr && \
  cmake --build $srcD/SQLiteCpp-build -j$(nproc) && \
  cmake --install $srcD/SQLiteCpp-build --strip && \
  rm -fr $srcD/SQLiteCpp $srcD/SQLiteCpp-build

# MongoDB C driver
RUN git clone --depth 1 --single-branch \
    https://github.com/mongodb/mongo-c-driver.git $srcD/mongo-c-driver && \
  cmake -S $srcD/mongo-c-driver -B $srcD/mongo-c-driver-build \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib -DENABLE_TESTS=OFF -DENABLE_EXAMPLES=OFF && \
  cmake --build $srcD/mongo-c-driver-build -j$(nproc) && \
  cmake --install $srcD/mongo-c-driver-build --strip && \
  rm -fr $srcD/mongo-c-driver $srcD/mongo-c-driver-build

# MongoDB C++ driver
RUN git clone --depth 1 --single-branch \
    https://github.com/mongodb/mongo-cxx-driver.git $srcD/mongo-cxx-driver && \
  cmake -S $srcD/mongo-cxx-driver -B $srcD/mongo-cxx-driver-build \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=ON -DENABLE_TESTS=OFF && \
  cmake --build $srcD/mongo-cxx-driver-build -j$(nproc) && \
  cmake --install $srcD/mongo-cxx-driver-build --strip && \
  rm -fr $srcD/mongo-cxx-driver $srcD/mongo-cxx-driver-build

# MatPlot++
RUN git clone --depth 1 --single-branch \
    https://github.com/alandefreitas/matplotplusplus.git $srcD/matplotplusplus && \
  cmake -S $srcD/matplotplusplus -B $srcD/matplotplusplus-build \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON -DMATPLOTPP_BUILD_EXAMPLES=OFF \
    -DMATPLOTPP_BUILD_SHARED_LIBS=ON -DMATPLOTPP_BUILD_TESTS=OFF && \
  cmake --build $srcD/matplotplusplus-build -j$(nproc) && \
  cmake --install $srcD/matplotplusplus-build --strip && \
  rm -fr $srcD/matplotplusplus $srcD/matplotplusplus-build

# sdbus-c++
RUN git clone --branch v2.1.0 --depth 1 --single-branch \
    https://github.com/Kistler-Group/sdbus-cpp.git $srcD/sdbus-cpp && \
  cmake -S $srcD/sdbus-cpp -B $srcD/sdbus-cpp-build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr -DSDBUSCPP_BUILD_DOCS=OFF && \
  cmake --build $srcD/sdbus-cpp-build -j$(nproc) && \
  cmake --install $srcD/sdbus-cpp-build --strip && \
  rm -fr $srcD/sdbus-cpp $srcD/sdbus-cpp-build

# The flatpak target of every branch installs its build dependencies into the
# per user installation, which the /var/jenkins_home volume would drop on every
# container start, so it is pointed out of the volume and seeded below.
ENV FLATPAK_USER_DIR=/var/flatpak

RUN install -d -o jenkins -g jenkins /var/flatpak

USER jenkins

RUN runtimes="${JENKINS_PIPELINE_FLATPAK_RUNTIMES}" && \
  flatpak remote-add --user --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo && \
  { test -z "$runtimes" || \
    flatpak install --user --noninteractive flathub $runtimes ; }

USER root

RUN cat > /usr/share/jenkins/ref/plugins.txt <<'EOF'
# Job organization
cloudbees-folder

# Security / Auth
matrix-auth
ldap

# Credentials
credentials-binding

# Build management
build-timeout
timestamper
ws-cleanup

# Build tools
ant
gradle

# SCM
git

# Pipeline
workflow-aggregator

# GitHub
github-branch-source
pipeline-github-lib

# Agents
ssh-slaves

# UI
dark-theme
theme-manager

# Email
email-ext
mailer

# Markup
antisamy-markup-formatter

# Visualization
pipeline-graph-view

# Test reports
junit

# Library dependency
jsoup

instance-identity
command-launcher
jdk-tool
pipeline-stage-view
github
ssh-credentials
credentials
plain-credentials
scm-api
branch-api
workflow-job
workflow-cps
workflow-support
workflow-basic-steps
workflow-durable-task-step
workflow-scm-step
EOF

RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt

# Every executor runs a build of its own with as many compiler jobs as the
# container has cores, so two of them is what a workstation survives.
RUN cat > /usr/share/jenkins/ref/init.groovy.d/executors.groovy <<'EOF'
import jenkins.model.Jenkins

def instance = Jenkins.instance
def executors = 2

if (instance.numExecutors != executors) {
  println "Setting the built-in node executors to " + executors
  instance.setNumExecutors(executors)
  instance.save()
}
EOF

RUN cat > /usr/share/jenkins/ref/init.groovy.d/import-jobs.groovy <<'EOF'
import jenkins.model.Jenkins

def instance = Jenkins.instance
def jobsDir = new File('/usr/share/jenkins/ref/jobs-import')

if (!jobsDir.exists()) {
  println "No jobs-import directory found"
  return
}

jobsDir.eachFileMatch(~/.*\.xml/) { file ->
  def jobName = file.name.replaceFirst(/\.xml$/, '')

  if (instance.getItem(jobName) != null) {
    println "Job '" + jobName + "' already exists, skipping"
    return
  }

  println "Importing job '" + jobName + "' from " + file

  file.withInputStream { stream ->
    instance.createProjectFromXML(jobName, stream)
  }
}

instance.save()
EOF

# ccache makes the repeated branch rebuilds cache hits: the first configure of
# every pipeline build directory picks the launchers from the environment.
ENV CCACHE_MAXSIZE=20G \
    CMAKE_C_COMPILER_LAUNCHER=ccache \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache

# The jobs come from the tree being configured instead of a clone of the
# published branch, and the CACHEBUST of the configure step refreshes them
# without invalidating any layer above.
ARG CACHEBUST

COPY --from=project --chown=jenkins:jenkins \
  misc/Jenkins/Jenkins-exported-jobs /usr/share/jenkins/ref/jobs-import

USER jenkins
