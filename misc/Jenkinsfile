pipeline {
  // WinUI 3 + C++/WinRT is a Windows-only stack, so this pipeline expects a
  // Windows build agent with Visual Studio 2022 (MSVC + CMake + ctest) and the
  // Windows App SDK / NuGet available. Label your Jenkins Windows node 'windows'
  // (or adjust the agent below).
  agent { label 'windows' }

  environment {
    BUILDDIR = 'build'
    BDJUNITOUT = 'junit-out'
    CMAKE_GENERATOR = 'Visual Studio 17 2022'
  }

  parameters {
    booleanParam(name: 'RUN_CPPCHECK', defaultValue: false, description: 'Run the cppcheck static code check?')
    booleanParam(name: 'RUN_DOC_URLS_CHECK', defaultValue: false, description: 'Template: check the external documentation URLs?')
  }

  stages {
    stage('Checkout') {
      when {
        expression { return !fileExists('CMakeLists.txt') }
      }

      steps {
        git branch: 'appWinUI3GLArea',
            url: 'https://github.com/yuriysydor1991/cpp-app-template.git'
      }
    }

    stage('Configure') {
      steps {
        bat '''
          cmake -S . -B %BUILDDIR% -G "%CMAKE_GENERATOR%" -A x64 ^
            -DENABLE_UNIT_TESTS=ON -DENABLE_COMPONENT_TESTS=ON ^
            -DENABLE_CPPCHECK=ON -DENABLE_WIX=ON -DMAX_LOG_LEVEL=5
        '''
      }
    }

    stage('Build (Debug)') {
      steps {
        bat 'cmake --build %BUILDDIR% --config Debug'
      }
    }

    stage('cppcheck') {
      when {
        expression { params.RUN_CPPCHECK }
      }
      steps {
        bat 'cmake --build %BUILDDIR% --config Debug --target cppcheck'
      }
    }

    stage('Unit Tests') {
      parallel {
        stage('UTEST_Application') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_Application\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_Application.junit.xml'
          }
        }
        stage('UTEST_ApplicationContext') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_ApplicationContext\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_ApplicationContext.junit.xml'
          }
        }
        stage('UTEST_ApplicationFactory') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_ApplicationFactory\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_ApplicationFactory.junit.xml'
          }
        }
        stage('UTEST_ApplicationHelpPrinter') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_ApplicationHelpPrinter\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_ApplicationHelpPrinter.junit.xml'
          }
        }
        stage('UTEST_ApplicationVersionPrinter') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_ApplicationVersionPrinter\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_ApplicationVersionPrinter.junit.xml'
          }
        }
        stage('UTEST_CommandLineParser') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_CommandLineParser\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_CommandLineParser.junit.xml'
          }
        }
        stage('UTEST_WindowConfig') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_WindowConfig\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_WindowConfig.junit.xml'
          }
        }
        stage('UTEST_WinUI3Controller') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_WinUI3Controller\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_WinUI3Controller.junit.xml'
          }
        }
        stage('UTEST_SignalsHandler') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_SignalsHandler\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_SignalsHandler.junit.xml'
          }
        }
        stage('UTEST_ASignalsHandler') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_ASignalsHandler\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_ASignalsHandler.junit.xml'
          }
        }
        stage('UTEST_ContinueSignalsHandler') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_ContinueSignalsHandler\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_ContinueSignalsHandler.junit.xml'
          }
        }
        stage('UTEST_IgnoredSignalsHandler') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_IgnoredSignalsHandler\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_IgnoredSignalsHandler.junit.xml'
          }
        }
        stage('UTEST_PauseSignalsHandler') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_PauseSignalsHandler\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_PauseSignalsHandler.junit.xml'
          }
        }
        stage('UTEST_ReloadSignalsHandler') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_ReloadSignalsHandler\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_ReloadSignalsHandler.junit.xml'
          }
        }
        stage('UTEST_StopSignalsHandler') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_StopSignalsHandler\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_StopSignalsHandler.junit.xml'
          }
        }
        stage('UTEST_UserSignalsHandler') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "UTEST_UserSignalsHandler\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/UTEST_UserSignalsHandler.junit.xml'
          }
        }
      }
      post { always { junit "${BUILDDIR}/${BDJUNITOUT}/UTEST_*.xml" } }
    }

    stage('Component Tests') {
      parallel {
        stage('CTEST_DefaultLogger') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "CTEST_DefaultLogger" --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/CTEST_DefaultLogger.junit.xml'
          }
        }
        stage('CTEST_log') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "CTEST_log\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/CTEST_log.junit.xml'
          }
        }
        stage('CTEST_app') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "CTEST_app\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/CTEST_app.junit.xml'
          }
        }
        stage('CTEST_WinUI3') {
          steps {
            bat 'cd %BUILDDIR% && ctest -C Debug -R "CTEST_WinUI3\\." --no-tests=error --output-on-failure --output-junit %BDJUNITOUT%/CTEST_WinUI3.junit.xml'
          }
        }
      }
      post { always { junit "${BUILDDIR}/${BDJUNITOUT}/CTEST_*.xml" } }
    }

    stage('Build (Release)') {
      steps {
        bat 'cmake --build %BUILDDIR% --config Release'
      }
    }

    stage('Release install') {
      steps {
        bat 'cmake --install %BUILDDIR% --config Release --prefix %BUILDDIR%\\install-try'
      }
    }

    stage('WIX package') {
      steps {
        bat 'cd %BUILDDIR% && cpack -C Release -G WIX'
      }
    }

    // =====================================================================
    // Template project specific checks.
    //
    // Everything below is specific to the cpp-app-template project itself and
    // is safe to delete in a real project implementation derived from this
    // template together with the scripts/pipelines/template-*.sh scripts the
    // stages run. The scripts are written generically - they discover the doc
    // sections, the enablers, the declared tests and the produced packages
    // dynamically, with no hardcoded names - so they can be reused as-is on
    // the other template branches.
    // =====================================================================

    // The template checks are POSIX shell scripts (git grep, find, sed, curl),
    // so they run on a GNU/Linux agent: label your Jenkins GNU/Linux node
    // 'linux' (or adjust the agent below).
    stage('Template checks') {
      agent { label 'linux' }

      stages {
        stage('Template: checkout') {
          when {
            expression { return !fileExists('CMakeLists.txt') }
          }

          steps {
            git branch: 'appWinUI3GLArea',
                url: 'https://github.com/yuriysydor1991/cpp-app-template.git'
          }
        }

        stage('Template: no git conflict markers') {
          steps {
            sh 'scripts/pipelines/template-no-conflict-markers.sh'
          }
        }

        stage('Template: no en_US doc sections in the uk_UA README') {
          steps {
            sh 'scripts/pipelines/template-readme-sections.sh doc/README.uk_UA.md en_US'
          }
        }

        stage('Template: no uk_UA doc sections in the top-level README') {
          steps {
            sh 'scripts/pipelines/template-readme-sections.sh README.md uk_UA'
          }
        }

        stage('Template: every doc section is linked in its README') {
          steps {
            sh 'scripts/pipelines/template-doc-sections-linked.sh'
          }
        }

        stage('Template: no broken markdown links') {
          steps {
            sh 'scripts/pipelines/template-markdown-links.sh'
          }
        }

        stage('Template: no broken external documentation URLs') {
          when { expression { params.RUN_DOC_URLS_CHECK } }
          steps {
            sh 'scripts/pipelines/template-doc-urls.sh'
          }
        }

        stage('Template: every enabler is registered') {
          steps {
            sh 'scripts/pipelines/template-enablers-registered.sh'
          }
        }

        stage('Template: every declared test is registered in the pipeline') {
          steps {
            sh 'scripts/pipelines/template-tests-registered.sh'
          }
        }
      }
    }
  }

  post {
    success {
      echo '✅ Builds & Tests passed!'
    }
    failure {
      echo '❌ Builds or Tests failed!'
    }
  }
}
