pipeline {
  agent any

  environment {
    BUILDDIR="build"
  }

  parameters {
    booleanParam(name: 'RUN_CPPCHECK', defaultValue: false, description: 'Run the cppcheck static code check?')
    // Template project specific: optional checks, all disabled by
    // default and opt-in (e.g. WIX is MS Windows only, FreeBSD pkg is FreeBSD
    // only). Safe to drop together with the template stages below.
    booleanParam(name: 'RUN_DOC_URLS_CHECK', defaultValue: false, description: 'Template: check the external documentation URLs?')
    booleanParam(name: 'RUN_DEB_PACKAGER', defaultValue: false, description: 'Template: build and check the deb package?')
    booleanParam(name: 'RUN_RPM_PACKAGER', defaultValue: false, description: 'Template: build and check the RPM package?')
    booleanParam(name: 'RUN_FREEBSD_PACKAGER', defaultValue: false, description: 'Template: build and check the FreeBSD pkg package? (FreeBSD only)')
    booleanParam(name: 'RUN_WIX_PACKAGER', defaultValue: false, description: 'Template: build and check the WIX MSI package? (MS Windows only)')
  }

  stages {
    stage('Checkout') {
      when {
        expression {
          def files = sh(script: 'ls -A', returnStdout: true).trim()
          return files == ""
        }
      }

      steps {
        git branch: 'libMeson',
            url: 'https://github.com/yuriysydor1991/cpp-app-template.git'
      }
    }

    stage('Code format configure') {
      steps {
        sh 'scripts/pipelines/code-format-configure.sh'
      }
    }

    stage('Code format build (clang-format)') {
      steps {
        sh 'scripts/pipelines/code-format-build.sh'
      }

      post {
        success {
          echo 'No files changed - OK'
        }
        failure {
          echo 'Some files are not formatted - FAIL'
        }
      }
    }

    stage('Debug configure') {
      steps {
        sh 'scripts/pipelines/debug-configure.sh'
      }
    }

    stage('Debug build') {
      steps {
        sh 'scripts/pipelines/build.sh'
      }
    }

    stage('cppcheck') {
      when {
        expression { params.RUN_CPPCHECK }
      }
      steps {
        sh 'scripts/pipelines/build.sh cppcheck'
      }
    }

    stage('Unit Tests') {
      parallel {
        stage('UTEST_LibraryFacade') {
          steps {
            sh 'scripts/pipelines/test.sh UTEST_LibraryFacade'
          }
        }
        stage('UTEST_LibFactory') {
          steps {
            sh 'scripts/pipelines/test.sh UTEST_LibFactory'
          }
        }
        stage('UTEST_LibMain') {
          steps {
            sh 'scripts/pipelines/test.sh UTEST_LibMain'
          }
        }
      }
      post { always { junit "$BUILDDIR/meson-logs/UTEST_*.junit.xml" } }
    }

    stage('Component Tests') {
      parallel {
        stage('CTEST_DefaultLogger') {
          steps {
            sh 'scripts/pipelines/test.sh CTEST_DefaultLogger'
          }
        }
        stage('CTEST_LibraryRealLogger') {
          steps {
            sh 'scripts/pipelines/test.sh CTEST_LibraryRealLogger'
          }
        }
      }
      post { always { junit "$BUILDDIR/meson-logs/CTEST_*.junit.xml" } }
    }

    stage('Debug configure (clang-tidy)') {
      steps {
        sh 'scripts/pipelines/clang-tidy-configure.sh'
      }
    }

    stage('Debug build (clang-tidy)') {
      steps {
        sh 'scripts/pipelines/build.sh clang-tidy'
      }
    }

    stage('Release configure') {
      steps {
        sh 'scripts/pipelines/release-configure.sh'
      }
    }

    stage('Release build') {
      steps {
        sh 'scripts/pipelines/build.sh'
      }
    }

    stage('Release install') {
      steps {
        sh 'scripts/pipelines/install.sh'
      }
    }

    stage('Template: no git conflict markers') {
      steps {
        sh 'scripts/pipelines/template-no-conflict-markers.sh'
      }
    }

    stage('Template: no en_US doc sections in the uk_UA README') {
      steps {
        sh 'scripts/pipelines/template-readme-sections.sh doc/README.uk_UA.md en_US'
      }
    }

    stage('Template: no uk_UA doc sections in the top-level README') {
      steps {
        sh 'scripts/pipelines/template-readme-sections.sh README.md uk_UA'
      }
    }

    stage('Template: every doc section is linked in its README') {
      steps {
        sh 'scripts/pipelines/template-doc-sections-linked.sh'
      }
    }

    stage('Template: no broken markdown links') {
      steps {
        sh 'scripts/pipelines/template-markdown-links.sh'
      }
    }

    stage('Template: every meson submodule is wired via subdir()') {
      steps {
        sh 'scripts/pipelines/template-meson-subdirs.sh'
      }
    }

    stage('Template: every declared test is registered in the pipeline') {
      steps {
        sh 'scripts/pipelines/template-tests-registered.sh'
      }
    }

    stage('Template: no broken external documentation URLs') {
      when { expression { params.RUN_DOC_URLS_CHECK } }
      steps {
        sh 'scripts/pipelines/template-doc-urls.sh'
      }
    }

    stage('Template: deb package') {
      when { expression { params.RUN_DEB_PACKAGER } }
      steps {
        sh 'scripts/pipelines/template-package-deb.sh'
      }
    }

    stage('Template: rpm package') {
      when { expression { params.RUN_RPM_PACKAGER } }
      steps {
        sh 'scripts/pipelines/template-package-rpm.sh'
      }
    }

    stage('Template: freebsd-pkg package') {
      when { expression { params.RUN_FREEBSD_PACKAGER } }
      steps {
        sh 'scripts/pipelines/template-package-freebsd.sh'
      }
    }

    stage('Template: wix-msi package') {
      when { expression { params.RUN_WIX_PACKAGER } }
      steps {
        sh 'scripts/pipelines/template-package-wix.sh'
      }
    }

  }

  post {
    success {
      echo '✅ Builds & Tests passed!'
    }
    failure {
      echo '❌ Builds or Tests failed!'
    }
  }
}
