{
  "id": "${FLATPAK_PROJECT_URL}",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "${PROJECT_BINARY_NAME}",
  "finish-args": [
    "--share=network"
  ],
  "modules": [
    {
      "name": "nlohmann-json",
      "buildsystem": "cmake",
      "builddir": true,
      "sources": [
        {
          "type": "git",
          "url": "${TEMPLATE_APP_NLOHMANN_GIT}",
          "tag": "${TEMPLATE_APP_NLOHMANN_GIT_TAG}"
        }
      ],
      "config-opts": [
        "-DJSON_BuildTests=OFF"
      ]
    },
    {
      "name": "liboai",
      "buildsystem": "cmake",
      "builddir": true,
      "sources": [
        {
          "type": "git",
          "url": "${TEMPLATE_APP_LIBOAI_GIT}",
          "tag": "${TEMPLATE_APP_LIBOAI_GIT_TAG}"
        }
      ],
      "config-opts": [
        "-DBUILD_EXAMPLES=OFF"
      ]
    },
    {
      "name": "${CMAKE_PROJECT_NAME}",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DENABLE_FLATPAK_METAINFO=ON"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "${CMAKE_SOURCE_DIR}"
        }
      ]
    }
  ]
}
