{
  "id": "${FLATPAK_PROJECT_URL}",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "${PROJECT_BINARY_NAME}",
  "modules": [
    {
      "name": "cfitsio",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DTESTS=OFF",
        "-DUTILS=OFF",
        "-DUSE_CURL=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://heasarc.gsfc.nasa.gov/FTP/software/fitsio/c/cfitsio-4.7.0.tar.gz",
          "sha256": "ce573bbea8e75b429f8c3d3e86498741ba3dc9628a1530d2f65268397ad059e8"
        }
      ]
    },
    {
      "name": "wcslib",
      "buildsystem": "autotools",
      "config-opts": [
        "--disable-flex",
        "--disable-fortran",
        "--disable-utils",
        "--without-pgplot",
        "--without-cfitsio"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://www.atnf.csiro.au/people/mcalabre/WCS/wcslib-releases/wcslib-8.9.tar.bz2",
          "sha256": "82ac09ce5091b0bf06cec8f5cdeec1dabe1d06ba5dfb7ff2bdb0c1680488807b"
        }
      ]
    },
    {
      "name": "${CMAKE_PROJECT_NAME}",
      "buildsystem": "cmake",
      "config-opts": ["-DCMAKE_BUILD_TYPE=Release"],
      "sources": [
        {
          "type": "dir",
          "path": "${CMAKE_SOURCE_DIR}"
        }
      ]
    }
  ]
}
