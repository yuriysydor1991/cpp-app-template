{
  "id": "${FLATPAK_PROJECT_URL}",
  "runtime": "org.kde.Platform",
  "runtime-version": "5.15-25.08",
  "sdk": "org.kde.Sdk",
  "command": "${PROJECT_BINARY_NAME}",
  "modules": [
    {
      "name": "plplot",
      "buildsystem": "cmake",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_C_FLAGS=-std=gnu17",
        "-DPLPLOT_USE_QT5=ON",
        "-DDEFAULT_NO_BINDINGS=ON",
        "-DENABLE_cxx=ON",
        "-DENABLE_qt=ON"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://git.code.sf.net/p/plplot/plplot",
          "tag": "master"
        }
      ]
    },
    {
      "name": "${CMAKE_PROJECT_NAME}",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DENABLE_FLATPAK_METAINFO=ON"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "${CMAKE_SOURCE_DIR}"
        }
      ]
    }
  ],
  "finish-args": [
    "--share=ipc", 
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ]
}
