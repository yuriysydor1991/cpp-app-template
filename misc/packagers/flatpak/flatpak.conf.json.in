{
  "id": "${FLATPAK_PROJECT_URL}",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "${PROJECT_BINARY_NAME}",
  "modules": [
    {
      "x-comment": "Builds the Firebird client library (libfbclient) with its ChaCha wire encryption plugin and installs the staged tree into /app. The client only mode leaves the DBMS server, its plugins and the examples out of the build. /app is the prefix libfbclient is compiled with, so it looks for firebird.conf, plugins.conf, firebird.msg and tzdata right there at run time.",
      "name": "firebird",
      "buildsystem": "simple",
      "build-commands": [
        "./autogen.sh --prefix=/app --enable-client-only --with-builtin-tommath --with-builtin-tomcrypt",
        "make -j$(nproc)",
        "cp -a extern/libtommath/.libs/libtommath.so* extern/libtomcrypt/.libs/libtomcrypt.so* gen/Release/firebird/lib/",
        "rm -rf gen/Release/firebird/bin gen/Release/firebird/tests",
        "cp -a gen/Release/firebird/. /app/"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/FirebirdSQL/firebird.git",
          "tag": "v5.0.4",
          "commit": "f6d83a28c009ab039ea40ffdb4ccc58f190dfbe6",
          "disable-submodules": true
        }
      ]
    },
    {
      "name": "${CMAKE_PROJECT_NAME}",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_PREFIX_PATH=/app",
        "-DENABLE_FLATPAK_METAINFO=ON"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "${CMAKE_SOURCE_DIR}",
          "skip": ["build"]
        }
      ]
    }
  ],
  "finish-args": [
    "--env=LD_LIBRARY_PATH=/app/lib:/app/lib64",
    "--share=network"
  ]
}
