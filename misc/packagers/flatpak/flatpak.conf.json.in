{
  "id": "${FLATPAK_PROJECT_URL}",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "command": "${PROJECT_BINARY_NAME}",
  "modules": [
    {
      "name": "libsigc++",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dbuild-examples=false",
        "-Dbuild-tests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libsigc++/2.12/libsigc++-2.12.1.tar.xz",
          "sha256": "a9dbee323351d109b7aee074a9cb89ca3e7bcf8ad8edef1851f4cf359bd50843"
        }
      ]
    },
    {
      "name": "glibmm",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dbuild-examples=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/glibmm/2.66/glibmm-2.66.10.tar.xz",
          "sha256": "2b61780203aed98e701d3ea57c8f353e7c8ada9706a79be782f6c5153dd035c0"
        }
      ]
    },
    {
      "name": "cairomm",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dbuild-examples=false",
        "-Dbuild-tests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://www.cairographics.org/releases/cairomm-1.14.6.tar.xz",
          "sha256": "7e0d5c7f29175d573a03ab5c45aef63f48dd91a5caf335a404cd763e4b7cea4a"
        }
      ]
    },
    {
      "name": "pangomm",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/pangomm/2.46/pangomm-2.46.5.tar.xz",
          "sha256": "38ca0b050b065de4e3da0c182df657437757063bbf0c4b6c9567ddba019b1d68"
        }
      ]
    },
    {
      "name": "atkmm",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/atkmm/2.28/atkmm-2.28.5.tar.xz",
          "sha256": "ae449192a582a2582a95e0602b15d792bbd639e836339b81ef916aa87540ac5c"
        }
      ]
    },
    {
      "name": "gtkmm",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dbuild-demos=false",
        "-Dbuild-tests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/gtkmm/3.24/gtkmm-3.24.8.tar.xz",
          "sha256": "d2940c64922e5b958554b23d4c41d1839ea9e43e0d2e5b3819cfb46824a098c4"
        }
      ]
    },
    {
      "name": "${CMAKE_PROJECT_NAME}",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DENABLE_FLATPAK_METAINFO=ON"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "${CMAKE_SOURCE_DIR}",
          "skip": ["build"]
        }
      ]
    }
  ],
  "finish-args": [
    "--filesystem=/run/host",
    "--share=ipc", 
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--talk-name=org.freedesktop.DBus",
    "--talk-name=org.freedesktop.Notifications",
    "--own-name=${FLATPAK_PROJECT_URL}"
  ]
}
