{
  "id": "${FLATPAK_PROJECT_URL}",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "${PROJECT_BINARY_NAME}",
  "modules": [
    {
      "name": "log4cpp",
      "buildsystem": "autotools",
      "sources": [
        {
          "type": "git",
          "url": "https://git.code.sf.net/p/log4cpp/codegit",
          "tag": "REL_1.1.6_Mar_12_2026",
          "commit": "5ce81a79fe9368e984165318d9ddb1f383e235dc"
        }
      ],
      "cleanup": ["/bin", "/sbin", "/include", "/lib/pkgconfig", "*.a", "*.la", "/share/aclocal", "/share/man", "/share/doc", "/doc"]
    },
    {
      "name": "${CMAKE_PROJECT_NAME}",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DENABLE_FLATPAK_METAINFO=ON"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "${CMAKE_SOURCE_DIR}"
        }
      ]
    }
  ]
}
