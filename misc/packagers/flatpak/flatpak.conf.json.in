{
  "id": "${FLATPAK_PROJECT_URL}",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "${PROJECT_BINARY_NAME}",
  "modules": [
    {
      "name": "gnuplot",
      "buildsystem": "simple",
      "builddir": true,
      "sources": [
        {
          "type": "git",
          "url": "https://git.code.sf.net/p/gnuplot/gnuplot-main",
          "tag": "5.4.10",
          "commit": "9c8f74b1b686911ed68504aacb45c96a26327135"
        }
      ],
       "build-commands": [
        "./prepare",
        "./configure --prefix=/app --without-lua --without-x",
        "make -j$(nproc)",
        "make install"
      ]
    },
    {
      "name": "matplotplusplus",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_INSTALL_PREFIX=/app",
        "-DMATPLOTPP_BUILD_EXAMPLES=OFF",
        "-DMATPLOTPP_BUILD_SHARED_LIBS=ON",
        "-DMATPLOTPP_BUILD_TESTS=OFF",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON"
      ], 
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/alandefreitas/matplotplusplus.git",
          "tag": "v1.2.2",
          "commit": "fe308e13f6c3ac7c5bd2b2f4717961d1d56d07ea"
        }
      ]
    },
    {
      "name": "${CMAKE_PROJECT_NAME}",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DENABLE_FLATPAK_METAINFO=ON"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "${CMAKE_SOURCE_DIR}"
        }
      ]
    }
  ],
  "finish-args": [
    "--share=ipc", 
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ]
}
