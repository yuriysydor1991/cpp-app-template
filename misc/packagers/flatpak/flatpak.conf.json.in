{
  "id": "${FLATPAK_PROJECT_URL}",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "${PROJECT_BINARY_NAME}",
  "modules": [
    {
      "name": "libpq",
      "buildsystem": "meson",
      "config-opts": [
        "-Ddocs=disabled",
        "-Ddocs_pdf=disabled",
        "-Dpltcl=disabled",
        "-Dssl=auto"
      ],
      "builddir": true,
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/postgres/postgres.git",
          "tag": "REL_17_5",
          "commit": "5e2f3df49d4298c6097789364a5a53be172f6e85"
        }
      ]
    },
    {
      "name": "libpqxx",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_INSTALL_PREFIX=/app",
        "-DBUILD_SHARED_LIBS=ON",
        "-DSKIP_BUILD_TEST=ON",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ], 
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/jtv/libpqxx.git",
          "tag": "7.10.1",
          "commit": "9bfaf9cb5a73ac23f9b7a9dfd7ef069a6e2124fb"
        }
      ]
    },
    {
      "name": "${CMAKE_PROJECT_NAME}",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_PREFIX_PATH=/app",
        "-DENABLE_FLATPAK_METAINFO=ON"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "${CMAKE_SOURCE_DIR}"
        }
      ]
    }
  ],
  "finish-args": [
    "--env=LD_LIBRARY_PATH=/app/lib:/app/lib64",
    "--share=network"
  ]
}
