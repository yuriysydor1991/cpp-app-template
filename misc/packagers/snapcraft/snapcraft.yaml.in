name: ${PROJECT_BINARY_NAME_lower}
base: core24
version: '${CMAKE_PROJECT_VERSION}'
summary: ${CMAKE_PROJECT_DESCRIPTION}
description: |
  ${CMAKE_PROJECT_DESCRIPTION}

grade: ${TEMPLATE_PROJECT_SNAP_GRADE}
confinement: ${TEMPLATE_PROJECT_SNAP_CONFINEMENT}

apps:
  ${PROJECT_BINARY_NAME}:
    command: ${SNAP_APP_COMMAND}${SNAP_APP_DESKTOP}
    plugs:
      - home${SNAP_APP_DESKTOP_PLUGS}
      # reads the org.freedesktop.hostname1 properties of the system bus
      - system-observe

parts:
  ${PROJECT_BINARY_NAME}:
    plugin: cmake
    source: '${PROJECT_SOURCE_DIR}'
    cmake-generator: '${CMAKE_GENERATOR}'
    cmake-parameters:
      - -DCMAKE_BUILD_TYPE=Release
      - -DCMAKE_INSTALL_PREFIX=${CMAKE_INSTALL_PREFIX}
    build-packages:
      - pkg-config
      - libsystemd-dev
