name: ${PROJECT_BINARY_NAME_lower}
base: core24
version: '${CMAKE_PROJECT_VERSION}'
summary: ${CMAKE_PROJECT_DESCRIPTION}
description: |
  ${CMAKE_PROJECT_DESCRIPTION}

grade: ${TEMPLATE_PROJECT_SNAP_GRADE}
confinement: ${TEMPLATE_PROJECT_SNAP_CONFINEMENT}

apps:
  ${PROJECT_BINARY_NAME}:
    command: ${PROJECT_BINARY_INSTALLATION_DIR}/${PROJECT_BINARY_NAME}${SNAP_APP_DESKTOP}
    plugs:
      - home${SNAP_APP_DESKTOP_PLUGS}
    environment:
      LD_LIBRARY_PATH: $SNAP/usr/lib/$CRAFT_ARCH_TRIPLET_BUILD_FOR
      QT_PLUGIN_PATH: $SNAP/usr/lib/$CRAFT_ARCH_TRIPLET_BUILD_FOR/qt6/plugins
      QML_IMPORT_PATH: $SNAP/usr/lib/$CRAFT_ARCH_TRIPLET_BUILD_FOR/qt6/qml

parts:
  ${PROJECT_BINARY_NAME}:
    plugin: cmake
    source: '${CMAKE_SOURCE_DIR}'
    cmake-generator: '${CMAKE_GENERATOR}'
    cmake-parameters:
      - -DCMAKE_BUILD_TYPE=Release
      - -DCMAKE_INSTALL_PREFIX=${CMAKE_INSTALL_PREFIX}
    build-packages:
      - qt6-base-dev
    stage-packages:
      - libqt6core6t64
      - libqt6dbus6t64
