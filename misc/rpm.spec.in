Name:           @PROJECT_NAME@
Version:        @PROJECT_VERSION@
Release:        1%{?dist}
Summary:        @PROJECT_DESCRIPTION@

License:        BSD
URL:            http://www.kytok.org.ua/
Group:          Applications/System
Packager:       @PROJECT_MAINTAINER@ <@PROJECT_MAINTAINER_EMAIL@>

BuildArch:      %{_arch}
AutoReqProv:    no

# The binaries come prebuilt from the Meson build, no debuginfo is extracted.
%global debug_package %{nil}

%description
@PROJECT_DESCRIPTION@

%install
# The rpm target stages the meson install output here, the rpmbuild itself
# starts the install section with an empty buildroot.
mkdir -p %{buildroot}
cp -a @RPM_STAGE_DIR@/. %{buildroot}/

%files -f @RPM_FILE_LIST@
%defattr(-,root,root,-)
