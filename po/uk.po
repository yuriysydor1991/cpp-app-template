#: src/app/applications/Application.cpp
msgid "Hello, gettext! Insert your translated messages here!"
msgstr "Привіт, gettext! Вставте сюди свої перекладені повідомлення!"

#: src/app/applications/ApplicationHelpPrinter.cpp
msgid "Usage:"
msgstr "Використання:"

#: src/app/applications/ApplicationHelpPrinter.cpp
msgid "[OPTIONS]"
msgstr "[ПАРАМЕТРИ]"

#: src/app/applications/ApplicationHelpPrinter.cpp
msgid ""
"Introduce a new command line flags by registering them in\n"
"the ApplicationHelpPrinter and the CommandLineParser classes."
msgstr ""
"Додавайте нові параметри командного рядка, реєструючи їх\n"
"у класах ApplicationHelpPrinter і CommandLineParser."

#. TRANSLATORS: the OPTIONS of the [OPTIONS] in the usage line.
#: src/app/applications/ApplicationHelpPrinter.cpp
msgid "Where OPTIONS may be next:"
msgstr "Де ПАРАМЕТРИ можуть бути такими:"

#. TRANSLATORS: joins the long and the short parameter names.
#: src/app/applications/ApplicationHelpPrinter.cpp
msgid "or"
msgstr "або"

#: src/app/applications/ApplicationHelpPrinter.cpp
msgid "print current help message"
msgstr "надрукувати поточне довідкове повідомлення"

#: src/app/applications/ApplicationHelpPrinter.cpp
msgid "print application version, build git commit and configure date"
msgstr "надрукувати версію програми, git-коміт збірки та дату конфігурування"

#: src/app/applications/ApplicationVersionPrinter.cpp
msgid "version"
msgstr "версія"

#: src/app/applications/ApplicationVersionPrinter.cpp
msgid "configure date"
msgstr "дата конфігурування"

#: src/app/applications/ApplicationVersionPrinter.cpp
msgid "git commit"
msgstr "git-коміт"
