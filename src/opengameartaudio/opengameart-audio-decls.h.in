#ifndef YOUR_CPP_APP_TEMPLATE_PROJECT_OPENGAMEART_AUDIO_DECLS_H
#define YOUR_CPP_APP_TEMPLATE_PROJECT_OPENGAMEART_AUDIO_DECLS_H

#include <string>

/// @brief Compile-time declarations of the OpenGameArt sound packs in use
namespace opengameart_audio_decls {

/// @brief The OpenGameArt sound packs root directory
const std::string OPENGAMEART_AUDIO_ROOT_DIR = "${OPENGAMEART_AUDIO_ROOT_DIR}" ;
/// @brief The Qt resource system prefix the generated .qrc manifests use
const std::string OPENGAMEART_AUDIO_QT_RESOURCE_PREFIX = "${OPENGAMEART_AUDIO_QT_RESOURCE_PREFIX}" ;
/// @brief The GResource prefix the generated .gresource.xml manifests use
const std::string OPENGAMEART_AUDIO_GRESOURCE_PREFIX = "${OPENGAMEART_AUDIO_GRESOURCE_PREFIX}" ;

} // namespace opengameart_audio_decls

#endif // YOUR_CPP_APP_TEMPLATE_PROJECT_OPENGAMEART_AUDIO_DECLS_H
