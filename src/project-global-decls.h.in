#ifndef YOUR_CPP_APP_TEMPLATE_PROJECT_GLOBAL_DECLS_H
#define YOUR_CPP_APP_TEMPLATE_PROJECT_GLOBAL_DECLS_H

#include <string>

/// @brief Global compile-time declarations of the project parameters
namespace project_decls {

/// @brief Global project' binary name
const std::string PROJECT_NAME = "${PROJECT_BINARY_NAME}" ;
/// @brief Global project' build version
const std::string PROJECT_BUILD_VERSION = "${PROJECT_VERSION}" ;
/// @brief Global project' configure git commit hash
const std::string PROJECT_BUILD_COMMIT = "${PROJECT_GIT_COMMIT}" ;
/// @brief Global project' configure date
const std::string PROJECT_CONFIGURE_DATE = "${PROJECT_CONFIGURE_DATE}" ;
/// @brief The network cfg file the application loads while no --cfg parameter is given
const std::string PROJECT_DARKNETXX_CFG_PATH = "${PROJECT_DARKNETXX_CFG_PATH}" ;
/// @brief The original Darknet weights file the application loads while no --weights or --dxxwjz1 parameter is given
const std::string PROJECT_DARKNETXX_WEIGHTS_PATH = "${PROJECT_DARKNETXX_WEIGHTS_PATH}" ;
/// @brief The class names file the application labels the objects with while no --names parameter is given
const std::string PROJECT_DARKNETXX_NAMES_PATH = "${PROJECT_DARKNETXX_NAMES_PATH}" ;
/// @brief The image the application detects the objects in while no --image parameter is given
const std::string PROJECT_DARKNETXX_IMAGE_PATH = "${PROJECT_DARKNETXX_IMAGE_PATH}" ;

} // namespace project_decls

#endif // YOUR_CPP_APP_TEMPLATE_PROJECT_GLOBAL_DECLS_H
