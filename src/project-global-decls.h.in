#ifndef YOUR_CPP_APP_TEMPLATE_PROJECT_GLOBAL_DECLS_H
#define YOUR_CPP_APP_TEMPLATE_PROJECT_GLOBAL_DECLS_H

#include <string>

/// @brief Global compile-time declarations of the project parameters
namespace project_decls {

/// @brief Global project' binary name
const std::string PROJECT_NAME = "${PROJECT_BINARY_NAME}" ;
/// @brief Global project' build version
const std::string PROJECT_BUILD_VERSION = "${PROJECT_VERSION}" ;
/// @brief Global project' configure git commit hash
const std::string PROJECT_BUILD_COMMIT = "${PROJECT_GIT_COMMIT}" ;
/// @brief Global project' configure date
const std::string PROJECT_CONFIGURE_DATE = "${PROJECT_CONFIGURE_DATE}" ;
/// @brief The text the application speaks while no --text parameter is given
const std::string PROJECT_TTS_TEXT = "${PROJECT_TTS_TEXT}" ;
/// @brief The voice of the speech engine the application speaks with while no --voice parameter is given
const std::string PROJECT_TTS_VOICE = "${PROJECT_TTS_VOICE}" ;
/// @brief The installed data directory of the project relative to the installed binary one
const std::string PROJECT_DATA_INSTALLED_RELATIVE_DIR = "${PROJECT_DATA_INSTALLED_RELATIVE_DIR}" ;
/// @brief The installed data directory of the project under the configured installation prefix
const std::string PROJECT_DATA_INSTALLED_DIR = "${PROJECT_DATA_INSTALLED_DIR}" ;

} // namespace project_decls

#endif // YOUR_CPP_APP_TEMPLATE_PROJECT_GLOBAL_DECLS_H
