#ifndef YOUR_CPP_APP_TEMPLATE_PROJECT_LIB_DECLS_H
#define YOUR_CPP_APP_TEMPLATE_PROJECT_LIB_DECLS_H

/**
 * @brief The library public C++ namespace name.
 *
 * CMake derives it from the top level project name, so every project derived
 * from this template owns a unique one and an application may depend on many
 * derived libraries at once. The installed public headers carry the very same
 * name already expanded, because an application which includes headers of two
 * derived libraries can not have a single macro standing for both of them.
 */
#define TEMPLATE_LIB_NAMESPACE @PROJECT_LIB_NAMESPACE@

/**
 * @brief The library implementation C++ namespace name. Not installed, but
 * still unique per derived project: the implementation symbols of a shared
 * library are exported the very same way the public ones are.
 */
#define TEMPLATE_LIB_IMPL_NAMESPACE @PROJECT_LIB_NAMESPACE@impl

/*
 * The logging subsystem owns a third project unique namespace,
 * TEMPLATE_DEFAULT_LOG_NAMESPACE. It is not declared here, because the
 * subsystem is shared with the projects which declare no library at all and
 * therefore generate no current header: CMake hands it over as a compile
 * definition instead. See src/log/default-logger/default-logger-decls.h.
 */

#endif  // YOUR_CPP_APP_TEMPLATE_PROJECT_LIB_DECLS_H
